# Backend
EXPO_PUBLIC_API_URL=https://test.api.marktcommerce.com/api/v1
EXPO_PUBLIC_SOCKET_URL=https://test.api.marktcommerce.com

# --- Social sign-in (see SETUP_OAUTH.md) ------------------------------------
# OAuth client IDs are NOT secrets — they ship inside every app binary either
# way. What makes a token trustworthy is the backend's audience check, not the
# secrecy of these values.
#
# The WEB client id is required even on mobile: it is what makes Google return
# an `idToken`. Without it you get an access token, which the backend cannot
# verify as an identity.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Apple needs no client id in the app — the native sheet uses the bundle
# identifier from app.json, and the backend checks that as the audience.
