# Markt Mobile — environment variables
#
# Copy to `.env` and adjust per environment. Expo inlines EXPO_PUBLIC_* vars at
# build time (Metro), so these are safe to reference from client code but are NOT
# secret — do not put private keys here.
#
# If unset, the app falls back to the TEST backend (see services/config.ts).

# REST API base (include the /api/v1 path segment)
# Test:       https://test.api.marktcommerce.com/api/v1
# Production:  https://api.marktcommerce.com/api/v1
EXPO_PUBLIC_API_URL=https://test.api.marktcommerce.com/api/v1

# Socket.IO host (no namespace/path — the /chat namespace is appended in config.ts)
# Test:       https://test.api.marktcommerce.com
# Production:  https://api.marktcommerce.com
EXPO_PUBLIC_SOCKET_URL=https://test.api.marktcommerce.com
